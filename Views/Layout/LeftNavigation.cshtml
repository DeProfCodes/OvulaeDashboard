@model LeftNavigationViewModel

<div class="app-header__logo">
    <div class="logo-src">
    </div>
    <div class="header__pane ml-auto">
        <div>
            <button type="button" class="hamburger close-sidebar-btn hamburger--elastic" data-class="closed-sidebar">
                <span class="hamburger-box">
                    <span class="hamburger-inner"></span>
                </span>
            </button>
        </div>
    </div>
</div>
<div class="app-header__mobile-menu">
    <div>
        <button type="button" class="hamburger hamburger--elastic mobile-toggle-nav">
            <span class="hamburger-box">
                <span class="hamburger-inner"></span>
            </span>
        </button>
    </div>
</div>
<div class="app-header__menu">
    <span>
        <button type="button" class="btn-icon btn-icon-only btn btn-primary btn-sm mobile-toggle-header-nav">
            <span class="btn-icon-wrapper">
                <i class="fa fa-ellipsis-v fa-w-6"></i>
            </span>
        </button>
    </span>
</div>

<!-- NAV -->
<div class="scrollbar-sidebar ps ps--active-y">
    <div class="app-sidebar__inner">
        <ul class="vertical-nav-menu metismenu">
            @if (Model.UserRole == UserRoleType.Admin)
            {
                <!-- Admin Nav Items -->
                <li class="app-sidebar__heading">Admin</li>
                <li>
                    <a onclick="NavigateToPage('@AppPageType.AdminDashboard')" class="left-nav-items" id="AdminDashboardLink">
                        <i class="metismenu-icon bi bi-grid-fill nav-icons"></i>Admin Center
                    </a>
                </li>
                <li>
                    <a aria-expanded="true" class="left-nav-items" id="UsersLink">
                        <i class="metismenu-icon bi bi-people-fill nav-icons"></i>Users Management
                        <i class="metismenu-state-icon bi bi-chevron-down caret-left chvron-arrow"></i>
                    </a>
                    <ul class="mm-collapse">
                        <li>
                            <a class="left-nav-items" id="UsersManagementLink" onclick="NavigateToPage('@AppPageType.UsersManagement')">
                                <i class="metismenu-icon bullet-point"></i>All
                            </a>
                        </li>
                        <li>
                            <a class="left-nav-items" id="PremiumUsersLink" onclick="NavigateToPage('@AppPageType.PremiumUsers')">
                                <i class="metismenu-icon bullet-point"></i>Premium
                                @if (Model.ActivePremiums > 0)
                                {
                                    <span class="badge badge-success fs-10 ms-1">@Model.ActivePremiums</span>
                                }
                                @if (Model.FreeTrialCount >= 0)
                                {
                                    <span class="badge bg-theme-clr-2 fs-10">@Model.FreeTrialCount</span>
                                }
                                @if (Model.PendingPremiums > 0)
                                {
                                    <span class="badge badge-warning fs-10">@Model.PendingPremiums</span>
                                }
                            </a>
                        </li>
                        <li>
                            <a class="left-nav-items" id="AffiliateUsersLink" onclick="NavigateToPage('@AppPageType.AffiliateUsers')">
                                <i class="metismenu-icon bullet-point"></i>Affiliates
                            </a>
                        </li>
                        <li>
                            <a class="left-nav-items" id="DoctorUsersLink" onclick="NavigateToPage('@AppPageType.DoctorUsers')">
                                <i class="metismenu-icon bullet-point"></i>Doctors
                            </a>
                        </li>
                        <li>
                            <a class="left-nav-items" id="PendingApprovalUsersLink" onclick="NavigateToPage('@AppPageType.PendingApprovalUsers')">
                                <i class="metismenu-icon bullet-point"></i>Pending Approval
                                @if (Model.PendingUsersCount > 0)
                                {
                                    <span class="badge badge-danger fs-10 ms-1">@Model.PendingUsersCount</span>
                                }
                            </a>
                        </li>
                    </ul>
                </li>
            }
            <!-- Dashboard Nav Items -->
            @if (Model.UserRole == UserRoleType.Affiliate || Model.UserRole == UserRoleType.Doctor)
            {
                var home = Model.UserRole == UserRoleType.Affiliate ? AppPageType.AffiliateDashboard : AppPageType.DoctorDashboard;
                var details = Model.UserRole == UserRoleType.Affiliate ? AppPageType.AffiliateDetails : AppPageType.DoctorDetails;
                var transactions = Model.UserRole == UserRoleType.Affiliate ? AppPageType.AffiliateTransactions : AppPageType.DoctorTransactions;

				var detailsText = Model.UserRole == UserRoleType.Affiliate ? "Affiliate Profile" : "Doctor Profile";

                <li class="app-sidebar__heading">Dashboard</li>
                <li>
                    <a onclick="NavigateToPage('@home')" class="left-nav-items" id="AffiliateDashboardLink">
                        <i class="metismenu-icon bi bi-house nav-icons"></i>Home
                    </a>
                </li>
                @if(Model.UserRole == UserRoleType.Doctor)
                {
                    <li>
                        <a onclick="NavigateToPage('@AppPageType.DoctorPatients')" class="left-nav-items" id="DoctorPatientsLink">
                            <i class="metismenu-icon bi bi-people nav-icons"></i>Patients
                        </a>
                    </li>
				}
                <li>
                    <a onclick="NavigateToPage('@details')" class="left-nav-items" id="AffiliateDetailsLink">
                        <i class="metismenu-icon bi bi-info-circle nav-icons"></i>@detailsText
                    </a>
                </li>
                <li>
                    <a onclick="NavigateToPage('@transactions')" class="left-nav-items" id="AffiliateTransanctionsLink">
                        <i class="metismenu-icon bi bi-arrow-left-right nav-icons"></i>Transactions
                    </a>
                </li>
            }
            <!-- Transactions Nav Items -->
            @if (Model.UserRole == UserRoleType.Admin)
            {
                <li class="app-sidebar__heading">Transact</li>
                <li>
                    <a onclick="NavigateToPage('@AppPageType.AllTransactions')" class="left-nav-items" id="AllTransactionsLink">
                        <i class="metismenu-icon bi bi-arrow-left-right nav-icons"></i>All Transactions
                    </a>
                </li>
                <li class="hidden">
                    <a class="left-nav-items" id="DepositLink">
                        <i class="metismenu-icon bi bi-credit-card nav-icons"></i>Deposit
                        <i class="metismenu-state-icon bi bi-chevron-down caret-left chvron-arrow"></i>
                    </a>
                    <ul class="mm-collapse">
                        <li>
                            <a class="left-nav-items" id="DepositHistoryLink" onclick="NavigateToPage('@AppPageType.DepositHistory')">
                                <i class="metismenu-icon bullet-point"></i> History
                            </a>
                        </li>
                        <li>
                            <a class="left-nav-items" id="DepositTopUpLink" onclick="NavigateToPage('@AppPageType.DepositTopUp')">
                                <i class="metismenu-icon bullet-point"></i> Top-Up
                            </a>
                        </li>
                    </ul>
                </li>
                <li>
                    <a class="left-nav-items" id="WithdrawLink">
                    <i class="metismenu-icon bi bi-bank nav-icons"></i>Payments
                    <i class="metismenu-state-icon bi bi-chevron-down caret-left chvron-arrow"></i>
                </a>
                <ul class="mm-collapse">
                    <li>
                        <a class="left-nav-items" id="WithdrawHistoryLink" onclick="NavigateToPage('@AppPageType.WithdrawHistory')">
                            <i class="metismenu-icon bullet-point"></i> History
                        </a>
                    </li>
                    <li>
                        <a class="left-nav-items" id="WithdrawRequestLink" onclick="NavigateToPage('@AppPageType.WithdrawRequest')">
                            <i class="metismenu-icon bullet-point"></i> Request
                        </a>
                    </li>
                </ul>
            </li>
            }
            <!-- Account Nav Items -->
            <li class="app-sidebar__heading">Account</li>
            <li>
                <a class="left-nav-items" id="AccountSettingsLink" onclick="NavigateToPage('@AppPageType.AccountSettings')">
                    <i class="metismenu-icon bi bi-gear nav-icons"></i>Settings
                </a>
            </li>
            <li>
                <a class="left-nav-items" id="SupportLink" onclick="NavigateToPage('@AppPageType.Support')">
                    <i class="metismenu-icon bi bi-headset nav-icons"></i>Support
                </a>
            </li>
            <li>
                <a onclick="Logout()" class="left-nav-items">
                    <i class="metismenu-icon bi bi-box-arrow-left nav-icons"></i>Logout
                </a>
            </li>
        </ul>
    </div>
    <div class="ps__rail-x" style="left: 0px; bottom: 0px;">
        <div class="ps__thumb-x" tabindex="0" style="left: 0px; width: 0px;"></div>
    </div>
    <div class="ps__rail-y" style="top: 0px; height: 851px; right: 0px;">
        <div class="ps__thumb-y" tabindex="0" style="top: 0px; height: 715px;"></div>
    </div>
</div>


<script src="~/js/dashboard/dashboard.js"></script>
<script src="~/js/dashboard/dashboard-1.js"></script>