
<div class="modal hidden" id="UserModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="false" style="display:block;">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header pb-1">
                <p class="w-100 text-center fw-bold fs-18">Edit User: <span id="UserModalTitleName"></span></p>
                <i class="bi bi bi-x-circle-fill text-danger modal-x-close" id="UserModalCloseIcon"></i>
            </div>
            <div class="modal-body">
                <div class="mt-3">
                    <label for="UserModalFirstname" class="form-label fs-16 clr-blue fw-bold">Firstname</label>
                    <input id="UserModalFirstname" placeholder="Enter Firstname" class="form-control" aria-invalid="false" type="text">
                    <p class="error-message fst-italic" id="UserModalFirstnameError"></p>
                </div>
                <div class="mt-3">
                    <label for="UserModalLastname" class="form-label fs-16 clr-blue fw-bold">Lastname</label>
                    <input id="UserModalLastname" placeholder="Enter Lastname" class="form-control" aria-invalid="false" type="text">
                    <p class="error-message fst-italic" id="UserModalLastname"></p>
                </div>
                <div class="mt-3">
                    <label for="UserModalEmail" class="form-label fs-16 clr-blue fw-bold">Email</label>
                    <input id="UserModalEmail" placeholder="Enter Email" class="form-control" aria-invalid="false" type="email">
                    <p class="error-message fst-italic" id="UserModalEmailError"></p>
                </div>
                <div class="mt-3">
                    <label for="UserModalRole" class="form-label fs-16 clr-blue fw-bold">Role</label>
                    <select class="form-select" id="UserModalRole">
                        <option value="">Please select...</option>
                        <option value="2">Client</option>
                        <option value="1">Admin</option>
                        <option value="3">Sales</option>
                        <option value="4">Partner</option>
                        <option value="5">Stakeholder</option>
                    </select>
                    <p class="error-message fst-italic" id="UserModalRoleError"></p>
                </div>
                <div class="mt-3">
                    <label for="UserModalPhoneNumber" class="form-label fs-16 clr-blue fw-bold">PhoneNumber</label>
                    <input id="cc" placeholder="Enter Phone Number" class="form-control" aria-invalid="false" type="text">
                    <p class="error-message fst-italic" id="UserModalPhoneNumberError"></p>
                </div>
            </div>
            <div class="modal-footer text-center">
                <div class="mx-auto">
                    <button class="btn btn-sm btn-danger alert-modal-btn" id="UserModalCancelBtn">Cancel</button>
                    <button class="btn btn-sm btn-primary alert-modal-btn ms-2" id="UserModalYesBtn">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show hidden" id="UserModalBackdrop"></div>

<script>

    function OpenUserModal(firstname, lastname, email, role, phoneNumber)
    {
        FlushUserModalValidationFormat();

        $("#UserModalTitleName").text(email);
        $("#UserModalFirstname").val(firstname);
        $("#UserModalLastname").val(lastname);
        SelectAnOptionWithValue("UserModalRole", role);
        $("#UserModalEmail").val(email);
        $("#UserModalPhoneNumber").val(phoneNumber);

        HideShowElement("#UserModal", HideShow.SHOW);
        HideShowElement("#UserModalBackdrop", HideShow.SHOW);

        var deferred = $.Deferred();

        $("#UserModalYesBtn").off("click").on("click", function ()
        {
            if (ValidateUserModalFields())
            {
                CloseUserModal();
                deferred.resolve(true);
            }
        });

        $("#UserModalCancelBtn").off("click").on("click", function ()
        {
            CloseUserModal();
            deferred.resolve(false);
        });

        $("#UserModalCloseIcon").off("click").on("click", function ()
        {
            CloseUserModal();
            deferred.resolve(false);
        });

        return deferred.promise();
    }

    function CloseUserModal()
    {
        HideShowElement("#UserModal", HideShow.HIDE);
        HideShowElement("#UserModalBackdrop", HideShow.HIDE);
    }

    function FlushUserModalValidationFormat()
    {
        $("#UserModalFirstname").removeClass("invalid-input-box");
        $("#UserModalLastname").removeClass("invalid-input-box");
        $("#UserModalRole").removeClass("invalid-input-box");
        $("#UserModalEmail").removeClass("invalid-input-box");
        $("#UserModalPhoneNumber").removeClass("invalid-input-box");

        $("#UserModalFirstnameError").text("");
        $("#UserModalLastnameError").text("");
        $("#UserModalRoleError").text("");
        $("#UserModalEmailError").text("");
        $("#UserModalPhoneNumberError").text("");
    }

    function ValidateUserModalFields()
    {
        FlushUserModalValidationFormat();

        var fname = $("#UserModalFirstname").val();
        var lname = $("#UserModalLastname").val();
        var role = $("#UserModalRole").val();
        var email = $("#UserModalEmail").val();
        var pNum = $("#UserModalPhoneNumber").val();

        var success = true;

        if(StringNullOrEmpty(fname))
        {
            $("#UserModalFirstnameError").text("*Please select Firstname");
            $("#UserModalFirstname").addClass("invalid-input-box");
            success = false;
        }
        if (StringNullOrEmpty(lname))
        {
            $("#UserModalLastnameError").text("*Please enter Lastname");
            $("#UserModalLastname").addClass("invalid-input-box");
            success = false;
        }
        if(StringNullOrEmpty(role))
        {
            $("#UserModalRoleError").text("*Please enter user role");
            $("#UserModalRole").addClass("invalid-input-box");
            success = false;
        }
        if (StringNullOrEmpty(email))
        {
            $("#UserModalEmailError").text("*Please enter valid email");
            $("#UserModalEmail").addClass("invalid-input-box");
            success = false;
        }
        if(ValidatePhoneNumber(pNum))
        {
            $("#UserModalPhoneNumberError").text("*Please enter valid phone number");
            $("#UserModalPhoneNumber").addClass("invalid-input-box");
            success = false;
        }
        return success;
    }

</script>