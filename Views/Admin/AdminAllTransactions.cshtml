@model AdminGeneralViewModel

@{
    var index = 1;
}

@{
    await Html.RenderPartialAsync("~/Views/Components/Breadcrumb.cshtml", new BreadcrumbViewModel
            {
                Icon = "bi-arrow-left-right",
                PageType = AppPageType.AdminAllTransactions
            });
}

<div class="mt-3 mb-3">
    <h2 class="tex-primary">All Transactions For : @Model.ClientFullname</h2>
</div>

<div class="row">
    <div class="card">
        <div class="card-header">
            <h5 class="text-primary">All Transactions</h5>
        </div>

        <div class="p-0 card-body">
            <div class="app-scroll table-responsive app-datatable-default">
                <div id="DefaultDataTable_wrapper" class="dataTables_wrapper no-footer">
                    <!-- Table -->
                    <table id="AllTransactionsHistory" class="w-100 display default-data-table align-middle table">
                        <thead>
                            <tr>
                                <th>Client Name</th>
                                <th class="text-center">Plan Name</th>
                                <th class="text-center">Type</th>
                                <th class="text-center">Amount</th>
                                <th class="text-center">Request Date</th>
                                <th class="text-center">Response Date</th>
                                <th class="text-center">Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in Model.AllTransactions)
                            {
                                var rowCss = (index++ % 2) == 0 ? "even" : "odd";

                                var sign = transaction.TransactionType == TransactionType.Withdrawal ? "-" : "";
                                var amountCss = transaction.TransactionType == TransactionType.Withdrawal ? "text-danger" : "text-success";

                                var statusBadge = HtmlCssHelper.GetBadgeCssForStatus(transaction.StatusType);
                                var bankInfo = transaction.BankDetails;
                                var transTypeBadge = HtmlCssHelper.GetBadgeCssForTransactionType(transaction.TransactionType);
                                var responseDate = (transaction.StatusType == StatusType.Paid && transaction.TransactionType == TransactionType.Withdrawal) ? 
                                                     HtmlCssHelper.GetTimeZonedTime(transaction.TransactionApprovalDate) : "";

                                <tr class="@rowCss">
                                    <td class="table-td">Sir</td>
                                    <td class="table-td text-center">@transaction.PlanName</td>
                                    <td class="table-td text-center"><span class="badge text-light-primary">@transaction.TransactionType.GetDisplayDescription()</span></td>
                                    <td class="table-td text-center @amountCss">@HtmlCssHelper.GetFormatedAmount(transaction.Amount)</td>
                                    <td class="table-td text-center">@HtmlCssHelper.GetTimeZonedTime(transaction.TransactionDate)</td>
                                    <td class="table-td text-center">@responseDate</td>
                                    <td class="table-td text-center"><span class="badge badge-@statusBadge">@transaction.StatusType.GetDisplayShortName()</span></td>
                                    <td>
                                        
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@{
    await Html.RenderPartialAsync("~/Views/Components/Dashboard/EditBankDetailsModal.cshtml");
}

<script>

    $(document).ready(function ()
    {
        HideAppLoader();
        MobileScreenUpdates();

        $('#AllTransactionsHistory').DataTable({
            pagingType: 'simple_numbers',
            lengthMenu: [10, 25, 50, 100], // Matches your options
            order: [], // 🔥 disables default sort
            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                paginate: {
                    previous: "Previous",
                    next: "Next"
                }
            }
        });
    });

</script>
