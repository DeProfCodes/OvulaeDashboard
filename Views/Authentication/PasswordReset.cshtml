@{
    ViewData["Title"] = "Password Reset";
    Layout = "_DashboardLayout";
}

<link rel="stylesheet" href="~/css/app/account.css" />

<div class="login-wrapper px-4">
    <div class="login-card">

        <!-- Logo -->
        <div class="text-center mb-3 cursor-pointer" onclick="HomePage()">
            <img src="~/images/logos/logo_main.webp" alt="Ovulae Logo" style="height: 100px;" />
        </div>

        <!-- Title -->
        <h4 class="text-center mb-3 mt-3 text-theme-clr-main">Recover Your Account</h4>

        <!-- Subtitle -->
        <p class="text-center fst-italic text-muted fs-14 mb-3">
            Securely reset your account password.
        </p>

        <!-- Error -->
        <p class="error-message text-center fw-bold" id="LoginError"></p>

        <!-- Step 1: Send Code -->
        <div id="SendEmailCode">
            <div class="mb-3">
                <input class="form-control" type="email" placeholder="Email address" id="Email">
                <p class="error-message" id="EmailError"></p>
            </div>

            <button type="submit" class="btn btn-theme-clr-main w-100" onclick="PasswordResetCode()">Send Code</button>
        </div>

        <!-- Step 2: Code Verification + Change Password -->
        <div id="CodeVerifyPassChange" class="hidden mt-4">
            <p class="mb-2 text-center fs-13 text-muted">
                A security code has been sent to <strong id="DestinationEmail"></strong>.
                Didn’t receive it?
                <span class="app-gold-clr cursor-pointer" onclick="ResendCode()">Resend</span> or
                <span class="text-darkgreen cursor-pointer" onclick="ChangeEmail()">Change Email</span>
            </p>

            <div class="mb-3">
                <input class="form-control" type="number" id="ResetCode" placeholder="Enter 8-digit Security Code" maxlength="8">
                <p class="error-message" id="ResetCodeError"></p>
            </div>

            <!-- New Password -->
            <div class="mb-3">
                <div class="d-flex">
                    <input class="form-control" id="psw-input" type="password" placeholder="New Password" onkeyup="CheckPasswordStrength()">
                    <div class="password-visibility" style="margin-left:-30px; margin-top:5px;">
                        <i class="bi bi-eye pass-eye fs-20" onclick="TogglePasswordMask()"></i>
                    </div>
                </div>
                <div class="progress" style="height: 5px;">
                    <div id="passwordStrengthBar" class="progress-bar bg-danger" style="width: 0%;"></div>
                </div>
                <p class="error-message" id="PasswordError"></p>

                <ul id="PasswordStrengthCriteria" class="list-unstyled text-muted mt-2">
                    <li id="minLength" class="strength-item">At least 8 characters</li>
                    <li id="numberCheck" class="strength-item">Contains a number</li>
                    <li id="uppercaseCheck" class="strength-item">Contains an uppercase letter</li>
                    <li id="lowercaseCheck" class="strength-item">Contains a lowercase letter</li>
                    <li id="specialCharCheck" class="strength-item">Contains a special character</li>
                </ul>
            </div>

            <!-- Confirm Password -->
            <div class="mb-3">
                <div class="d-flex">
                    <input class="form-control" id="psw-input-2" type="password" placeholder="Confirm Password">
                    <div class="password-visibility" style="margin-left:-30px; margin-top:5px;">
                        <i class="bi bi-eye pass-eye fs-20" onclick="TogglePasswordMask()"></i>
                    </div>
                </div>
                <p class="error-message" id="PasswordConfError"></p>
            </div>

            <!-- Change Password -->
            <button type="submit" class="btn btn-theme-clr-main w-100" onclick="ChangePasswordCode()">Change Password</button>
        </div>

        <!-- Navigation Links -->
        <div class="text-center mt-3 fs-14">
            <p class="mb-0">
                Back to <a asp-action="Login" class="text-theme-clr-2 fw-semibold text-decoration-none">Login</a> or
                <a asp-action="Register" class="text-theme-clr-2 fw-semibold text-decoration-none">Register</a>
            </p>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    $(document).ready(function()
    {
        HideShowElement("#PreLoaderModal", HideShow.HIDE);
        HideShowElement("#PreLoaderModalBackdrop", HideShow.HIDE);
    });

    function PasswordResetCode()
    {
        $("#Email").removeClass("invalid-input-box");
        $("#EmailError").text("");

        var email = $("#Email").val();

        if (!CheckEmail(email))
        {
            $("#EmailError").text("Enter valid email");
            $("#Email").addClass("invalid-input-box");
            return;
        }


        ShowAppLoader("Sending Password Reset Code...");

        var url = "@Url.Action("PasswordResetCode", "Authentication")";
        var payload = { email: email };

        PerformAction(url, "POST", payload, PasswordResetCallback);

    }

    function ResendCode()
    {
        ShowAppLoader("Sending Password Reset Code...");

        var url = "@Url.Action("PasswordResetCode", "Authentication")";

        var payload = { email: $("#Email").val() };

        PerformAction(url, "POST", payload, PasswordResetCallback);
    }

    function ChangeEmail()
    {
        HideShowElement("#SendEmailCode", HideShow.SHOW);
        HideShowElement("#CodeVerifyPassChange", HideShow.HIDE);
    }

    function PasswordResetCallback(success, response)
    {
        HideAppLoader();
        if(success)
        {
            var email = $("#Email").val();

            $("#DestinationEmail").text(email);

            HideShowElement("#SendEmailCode", HideShow.HIDE);
            HideShowElement("#CodeVerifyPassChange", HideShow.SHOW);

            ShowAlertModal('Code Sent', `Your Password Reset Code has been sent to email: ${email}.`, '@AlertModalIconType.Success');
        }
        else
        {
            ShowAlertModal('Code Failed', `${response.responseJSON.error}`, '@AlertModalIconType.Error');
        }
    }

    function ChangePasswordCode()
    {
        $("#ResetCodeError").text("");
        $("#PasswordConfError").text("");

        $("#ResetCode").removeClass("invalid-input-box");
        $("#psw-input-2").removeClass("invalid-input-box");
        $("#psw-input").removeClass("invalid-input-box");

        var code = $("#ResetCode").val();
        var password = $("#psw-input").val();
        var confirmPassword = $("#psw-input-2").val();

        var success = true;

        if (StringNullOrEmpty(code))
        {
            $("#ResetCodeError").text("Enter code");
            $("#ResetCode").addClass("invalid-input-box");
            success = false;
        }
        if (password != confirmPassword)
        {
            $("#PasswordConfError").text("Passwords do not match!");
            $("#psw-input-2").addClass("invalid-input-box");
            success = false;
        }
        if (!CheckPasswordStrength())
        {
            $("#psw-input").addClass("invalid-input-box");
            success = false;
        }

        if (!success) return;

        ShowAppLoader("Resetting Password...");

        var url = "@Url.Action("PasswordResetCodeVerify", "Authentication")";

        var payload =
        {
            Email: $("#Email").val(),
            Password: password,
            PasswordResetCode: code
        };

        PerformAction(url, "POST", payload, PasswordResetVerifyCallback);
    }

    function PasswordResetVerifyCallback(success, response)
    {
        if(success)
        {
            ShowAlertModal('Password Changed', `You have successfully changed the Password.`, '@AlertModalIconType.Success').then(function (yes)
            {
                window.location = "@Url.Action("Login", "Authentication")";
            });
        }
        else
        {
            HideAppLoader();
            ShowAlertModal('Error', `${response.responseJSON.error}`, '@AlertModalIconType.Error');
            //$("#ResetCodeError").text(`${response.responseJSON.error}`);
        }
    }

</script>
