

<div class="container">
    <!-- User Information-->
    <div class="card user-info-card mb-3">
        <div class="card-body d-flex align-items-center">
            <div class="user-profile me-3 bg-gray">
                <img src="~/images/others/profile_icon.png" alt="" id="UserProfileImage">
            </div>
            <div class="user-info">
                <div class="d-flex align-items-center">
                    <h5 class="mb-1">Affan Islam</h5>
                    <span class="badge bg-warning ms-2 rounded-pill">Pro</span>
                </div>
                <p class="mb-0">Deriv Broker</p>
            </div>
        </div>
    </div>

    <!-- User Meta Data-->
    <div class="card user-data-card">
        <div class="card-body">
            <form action="#">
                <div class="form-group mb-3">
                    <label class="form-label" for="Username">Username</label>
                    <input class="form-control" id="Username" type="text" value="@@designing-world" placeholder="Username" readonly>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="fullname">Full Name</label>
                    <input class="form-control" id="fullname" type="text" value="Affan Islam" placeholder="Full Name">
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="cellphone">Cellphone</label>
                    <input class="form-control" id="cellphone" type="text" value="0737942244" placeholder="Your Cellphone">
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="email">Email Address</label>
                    <input class="form-control" id="email" type="text" value="care@example.com" placeholder="Email Address" readonly>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" for="job">Broker Name</label>
                    <input class="form-control" id="job" type="text" value="Deriv" placeholder="Your broker name">
                </div>

                <button class="btn btn-success w-100" type="submit">Update Now</button>
            </form>
        </div>
    </div>
</div>
