
<!-- Login Wrapper Area -->
<div class="d-flex align-items-center justify-content-center">
    <div class="custom-container" id="PasswordResetContainer">
        <div class="text-center">
            <img class="login-intro-img" src="~/images/account/reset_password.png" alt="" id="PasswordResetImage">
        </div>

        <!-- Register Form -->
        <div class="register-form mt-4">
            <form action="login.html">
                <h4 class="mb-3 text-center">Update your password</h4>

                <div class="form-group text-start mb-3">
                    <input class="form-control" type="text" placeholder="Enter 8 digit security code">
                    <p class="mb-0 text-blue mt-1 ms-1 cursor-pointer">Send Code</p>
                </div>

                <div class="form-group text-start mb-3 position-relative">
                    <input class="form-control" id="psw-input" type="password" placeholder="New password">
                    <div class="position-absolute" id="password-visibility">
                        <i class="bi bi-eye"></i>
                        <i class="bi bi-eye-slash"></i>
                    </div>
                </div>

                <div class="mb-3" id="pswmeter"></div>

                <div class="form-group text-start mb-3">
                    <input class="form-control" type="password" placeholder="Re-write password">
                </div>

                <button class="btn btn-primary w-100 mb-3" type="submit">Update Password</button>
            </form>
        </div>
    </div>
</div>