@using Newtonsoft.Json
@model WithdrawalFundsRequestViewModel

@{
    await Html.RenderPartialAsync("~/Views/Components/Breadcrumb.cshtml", new BreadcrumbViewModel
            {
                Icon = "bi-bank",
                PageType = AppPageType.WithdrawRequest,
                ActionButton = new BreadcrumbButton
                {
                    ButtonText = "Withdrawals History",
                    ButtonIconCss = "bi-bank",
                    Page = AppPageType.WithdrawHistory
                }
            });
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="text-primary">Request Withdrawal</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Left Column: Payout Form -->
                    <div class="col-lg-7 col-xl-6">
                        <h5 class="text-center mb-4 text-primary fw-bold">Request Affiliate Payout</h5>

                        <div class="alert bg-theme-clr-3 fs-14 fst-italic text-white">
                            ⏳ All affiliate payout requests are processed within <strong>1–3 business days</strong>. If not received, please contact <a href="/support" class="text-decoration-underline text-theme-clr-2">support</a>.
                        </div>
                        <div class="alert bg-theme-light fs-14 fst-italic">
                            💸 <strong>Minimum Payout:</strong> $25 &nbsp;&nbsp;&nbsp; <strong>Max per Request:</strong> $50,000
                        </div>

                        <!-- Payout Amount -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Enter Amount to Withdraw ($)</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">$</span>
                                <input type="number" id="AffiliatePayoutAmount" class="form-control" min="50" max="50000" step="1" value="0" />
                            </div>
                            <p class="text-success fs-12 fst-italic mt-1" id="PayoutRangeNote">
                                * Between R50 and your available balance.
                            </p>
                        </div>

                        <!-- Earnings Summary -->
                        <div class="mt-3 p-3 border rounded bg-theme-clr-purple">
                            <h6 class="fw-bold mb-3">Affiliate Earnings Summary</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td>Total Earned</td>
                                    <td class="text-end text-primary fw-bold">$<span id="TotalAffiliateEarned">4,512</span></td>
                                </tr>
                                <tr>
                                    <td>Pending Payouts</td>
                                    <td class="text-end text-warning fw-bold">$<span id="AffiliatePending">812</span></td>
                                </tr>
                                <tr>
                                    <td>Available Balance</td>
                                    <td class="text-end text-success fw-bold">$<span id="AffiliateAvailable">3,700</span></td>
                                </tr>
                            </table>
                        </div>

                        <!-- Payout Button -->
                        <div class="text-center mt-4">
                            <button class="btn btn-primary px-5 fw-bold" onclick="SubmitAffiliatePayout()">
                                Request Payout
                            </button>
                        </div>
                    </div>

                    <!-- Right Column: Visual Aid -->
                    <div class="col-lg-5 col-xl-6 d-none d-lg-block">
                        <div class="card border-0 h-100 text-center bg-white">
                            <img src="~/images/dashboard/transact/withdraw3.png" alt="Affiliate Payout Illustration" class="img-fluid rounded" style="max-width:600px"/>
                            <p class="mt-3 text-muted fs-14">Keep growing your referrals to earn more commissions!</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Components/Dashboard/EditBankDetailsModal.cshtml");
}

<script>

    var allUserWithdrawPlans = @Html.Raw(JsonConvert.SerializeObject(Model.PlansAvailableFunds));

    $(document).ready(function ()
    {
        HideAppLoader();
        ChangeContentOfWithdrawalBtn();

        var amount = $("#InvestmentAmount").val();
        $("#InvestmentPlanFeesTotalPay2").text(FormatMoney(amount));

        NoPlansAvaiable();
    });

    function SubmitPlanWithdrawal()
    {
        $("#TopUpPlanNameError").text("");
        $("#TopUpPlanName").removeClass("invalid-input-box");

        var planId = $("#TopUpPlanName").val().trim();
        var planName = GetTextOfSelectedOptionInSelectList("TopUpPlanName");
        var amount = parseInt($("#InvestmentAmount").val());

        if(planId == 0)
        {
            $("#TopUpPlanNameError").text("*Please select a plan to Withdraw From");
            $("#TopUpPlanName").addClass("invalid-input-box");
            return;
        }
        
        if(amount == 0)
        {
            ShowAlertModal(
                'Error Withdrawal',
                `Please withdraw from Investment Plan which has available funds for withdrawal.`,
                '@AlertModalIconType.Error'
            );
            return;
        }

        if(amount < 50)
        {
            ShowAlertModal(
                'Error Withdrawal',
                `Please request withdrawal of R50 or more.`,
                '@AlertModalIconType.Error'
            );
            return;
        }

        ShowAlertModal(
            'Withdrawal',
            `Are you sure you want to Withdraw from investment plan '${planName}' Amount of = R${FormatMoney(amount)}?`,
            '@AlertModalIconType.Question').then(function (confirmed)
        {
            if(confirmed)
            {
                OpenEditBankDetailsMondal(
                    "@Model.BankDetailsModel.BankName", "@Model.BankDetailsModel.BranchCode", "@Model.BankDetailsModel.AccountNumber",
                    "@Model.BankDetailsModel.AccountNumber").then(function(confirmd)
                {
                    if(confirmed)
                    {
                        ShowAppLoader("Requesting Withdrawal...");

                        var url = "@Url.Action("WithdrawRequest", "Transactions")";

                        var payload =
                        {
                            BankDetails:
                            {
                                BankName: $("#EditBankName").val(),
                                AccountNumber: $("#EditAccountNumber").val(),
                                AccountType: $("#EditAccountType").val(),
                                BranchCode: $("#EditBankBranchCode").val()
                            },
                            SaveBankDetails: IsCheckboxChecked("SaveBankDetailsCheck"),
                            PlanId: planId,
                            Amount: amount,
                        }
                        PerformAction(url, "POST", payload, PlanWithdrawalCallback);
                    }
                });
            }
        });
    }

    function PlanWithdrawalCallback(success, response)
    {
        HideAppLoader();
        if (success)
        {
            ShowAlertModal("Successful", "Your withdrawal request was captured successfully and will be processed within 1 - 3 Business days.", "@AlertModalIconType.Success").then(function(okay)
            {
                NavigateToPage(response.page);
            });
        }
        else
        {
            ShowAlertModal("Error", "Failed to process withdrawal, something went wrong, Please try again. If the error persist then contact support.", "@AlertModalIconType.Error");
        }
    }

    function WithdrawRequestPlanChange()
    {
        $("#TopUpPlanNameError").text("");
        $("#TopUpPlanName").removeClass("invalid-input-box");

        var planId = parseInt($("#TopUpPlanName").val());

        if(planId > 0)
        {
            var plan = allUserWithdrawPlans.find(p => p.PlanId === planId);

            var pending = (plan.PlanSetAutoReInvest ? "R" : "-R") + FormatMoney(plan.TotalPendingWithdrawalsAmount);

            $("#TotalAvailableForWithdraw").text(`R${FormatMoney(plan.TotalAvailableMoneyForWithdrawal)}`);
            $("#TotalPendingWithdrawals").text(pending);
            $("#TotalWithdrawableAmount").text(`R${FormatMoney(plan.WithdrawableAmount)}`);

            var showWarnMsg = plan.PlanSetAutoReInvest ? HideShow.SHOW : HideShow.HIDE;
            HideShowElement("#AutoReInvestOnWarning", showWarnMsg);
            
            if(plan.WithdrawableAmount > 0)
            {
                HideShowElement("#MaxWithdrawableNoteP", HideShow.SHOW);
            }

            var maxWithdrawal = plan.WithdrawableAmount < 100000 ? parseInt(plan.WithdrawableAmount) : 100000;
            $("#MaxWithdrawableNote").text(`R${FormatMoney(maxWithdrawal)}`);
            $("#InvestmentAmount").attr("max", maxWithdrawal);
            $("#InvestmentAmount").val(maxWithdrawal);
        }
        else
        {
            $(".withdraw-available-amounts").text("");
            HideShowElement("#MaxWithdrawableNoteP", HideShow.HIDE);
            $("#InvestmentAmount").attr("max", 0);
            $("#InvestmentAmount").val(0);
        }
    }

    // Enforce min/max when user leaves input
    $("#InvestmentAmount").on("blur", function()
    {
        var minVal = parseInt($(this).attr("min"), 10);
        var maxVal = parseInt($(this).attr("max"), 10);
        var currentVal = parseInt($(this).val(), 10);

        if (isNaN(currentVal) || currentVal < minVal)
        {
            $(this).val(minVal);
            currentVal = minVal;
        }
        else if (currentVal > maxVal)
        {
            $(this).val(maxVal);
            currentVal = maxVal;
        }

        if(maxVal < minVal)
        {
            $(this).val(maxVal);
        }

        $("#InvestmentPlanFeesTotalPay2").text(FormatMoney(currentVal));
    });

    $("#InvestmentAmount").on("input", function(event)
    {
        var value = $(this).val().replace(/,/g, "");
        value = value.replace(/\D/g, "");

        if (value.length > 6)
            value = value.substring(0, 6);

        $(this).val(value);

        $("#InvestmentPlanFeesTotalPay2").text(FormatMoney(value));
    });

    $(window).on("resize", function ()
    {
        ChangeContentOfWithdrawalBtn();
    });

    function ChangeContentOfWithdrawalBtn()
    {
        if ($(window).width() <= 450)
        {
            $("#BreadcrumbActBtnTxt").text("W-History");
        }
        else
        {
            $("#BreadcrumbActBtnTxt").text("Withdrawal History");
        }
    }

</script>