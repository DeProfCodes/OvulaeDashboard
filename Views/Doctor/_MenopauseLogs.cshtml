@using OvulaeDashboard.ViewModels.Doctor
@using OvulaeShared.Enums.App
@using OvulaeShared.Helpers.CommonFunctions
@using OvulaeShared.Models.Menopause
@model MenopauseLogsViewModel

@{
    List<MenopauseLogEntry> menopauseLogs = Model.Logs;
	var userId = Model.PatientUserId;

    string trackerType = "menopause";

    int GetInt(int? value)
    {
        return DefaultValueHelper.GetIntValueOrDefault(value);
    }
}

<div class="card module-card @(ViewBag.IsCurrent == true ? "current-tracker" : "")" id="@(trackerType)-tracker">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0 text-white"><i class="bi bi-droplet"></i> Menopause Tracker</h5>
        <div class="pagination-info" id="@(trackerType)-pagination-info">
            <small>Loading...</small>
        </div>
    </div>
    <div class="card-body" id="@(trackerType)-card-body">
        @if (!menopauseLogs.Any())
        {
            <p class="text-muted">No menopause logs available</p>
        }
        else
        {
            foreach (var log in menopauseLogs.OrderByDescending(x => x.LogDate))
            {
                <div class="log-entry @(trackerType)-log-entry">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@log.PhaseName Phase</strong>
                            <small class="text-muted ms-2">@log.LogDate.ToString("dd MMM yyyy, dddd")</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(log.HadBleeding ? "bg-danger" : "bg-secondary")">
                                @(log.HadBleeding ? "Bleeding" : "No Bleeding")
                            </span>
                            <button class="btn btn-sm btn-outline-primary @(trackerType)-toggle-details-btn" data-log-id="@log.EntryId">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Minimal Bars Only -->
                    <div class="compact-2col-ratings mt-2">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Hot Flashes: @log.HotFlashesSeverity</div>
                                    <div class="compact-bar-outer">
                                        @{
                                            var hotFlashWidth = log.HotFlashesSeverity switch
                                            {
                                                "None" => "0%",
                                                "Mild" => "25%",
                                                "Moderate" => "50%",
                                                "Severe" => "100%",
                                                _ => "0%"
                                            };
                                            var hotFlashColor = log.HotFlashesSeverity switch
                                            {
                                                "None" => "#6c757d",
                                                "Mild" => "#ffc107",
                                                "Moderate" => "#fd7e14",
                                                "Severe" => "#dc3545",
                                                _ => "#6c757d"
                                            };
                                        }
                                        <div class="compact-bar-fill" style="width: @hotFlashWidth; background: @hotFlashColor;"></div>
                                    </div>
                                </div>
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Night Sweats: @log.NightSweatsSeverity</div>
                                    <div class="compact-bar-outer">
                                        @{
                                            var nightSweatWidth = log.NightSweatsSeverity switch
                                            {
                                                "None" => "0%",
                                                "Mild" => "25%",
                                                "Moderate" => "50%",
                                                "Severe" => "100%",
                                                _ => "0%"
                                            };
                                            var nightSweatColor = log.NightSweatsSeverity switch
                                            {
                                                "None" => "#6c757d",
                                                "Mild" => "#ffc107",
                                                "Moderate" => "#fd7e14",
                                                "Severe" => "#dc3545",
                                                _ => "#6c757d"
                                            };
                                        }
                                        <div class="compact-bar-fill" style="width: @nightSweatWidth; background: @nightSweatColor;"></div>
                                    </div>
                                </div>
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Energy: @log.EnergyLevel</div>
                                    <div class="compact-bar-outer">
                                        @{
                                            var energyWidth = log.EnergyLevel switch
                                            {
                                                "Low" => "25%",
                                                "Normal" => "50%",
                                                "High" => "100%",
                                                _ => "0%"
                                            };
                                            var energyColor = log.EnergyLevel switch
                                            {
                                                "Low" => "#dc3545",
                                                "Normal" => "#ffc107",
                                                "High" => "#28a745",
                                                _ => "#6c757d"
                                            };
                                        }
                                        <div class="compact-bar-fill" style="width: @energyWidth; background: @energyColor;"></div>
                                    </div>
                                </div>
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Libido: @log.Libido</div>
                                    <div class="compact-bar-outer">
                                        @{
                                            var libidoWidth = log.Libido switch
                                            {
                                                "Low" => "25%",
                                                "Normal" => "50%",
                                                "High" => "100%",
                                                _ => "0%"
                                            };
                                            var libidoColor = log.Libido switch
                                            {
                                                "Low" => "#dc3545",
                                                "Normal" => "#ffc107",
                                                "High" => "#28a745",
                                                _ => "#6c757d"
                                            };
                                        }
                                        <div class="compact-bar-fill" style="width: @libidoWidth; background: @libidoColor;"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Urination: @GetInt(log.UrinationRating)</div>
                                    <div class="compact-bar-outer">
                                        <div class="compact-bar-fill" style="width: @(GetInt(log.UrinationRating * 10))%; background: @HtmlCssHelper.GetColorForRating(log.UrinationRating);"></div>
                                    </div>
                                </div>
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Skin Dryness: @GetInt(log.SkinDrynessRating)</div>
                                    <div class="compact-bar-outer">
                                        <div class="compact-bar-fill" style="width: @(GetInt(log.SkinDrynessRating * 10))%; background: @HtmlCssHelper.GetColorForRating(log.SkinDrynessRating);"></div>
                                    </div>
                                </div>
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Breast Tenderness: @GetInt(log.BreastTendernessRating)</div>
                                    <div class="compact-bar-outer">
                                        <div class="compact-bar-fill" style="width: @(GetInt(log.BreastTendernessRating * 10))%; background: @HtmlCssHelper.GetColorForRating(log.BreastTendernessRating)"></div>
                                    </div>
                                </div>
                                <div class="compact-bar-item">
                                    <div class="compact-bar-title">Sleep: @log.SleepQuality</div>
                                    <div class="compact-bar-outer">
                                        @{
                                            var sleepWidth = log.SleepQuality switch
                                            {
                                                "Poor" => "25%",
                                                "Moderate" => "50%",
                                                "Good" => "100%",
                                                _ => "0%"
                                            };
                                            var sleepColor = log.SleepQuality switch
                                            {
                                                "Poor" => "#dc3545",
                                                "Moderate" => "#ffc107",
                                                "Good" => "#28a745",
                                                _ => "#6c757d"
                                            };
                                        }
                                        <div class="compact-bar-fill" style="width: @sleepWidth; background: @sleepColor;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2">
                        @if (log.Symptoms.Any())
                        {
                            <div class="mb-2">
                                @foreach (var symptom in log.Symptoms)
                                {
                                    <span class="symptom-badge bg-theme-clr-3 text-white">@symptom</span>
                                }
                            </div>
                        }

                        @if (log.Moods.Any())
                        {
                            <div class="mb-2">
                                @foreach (var mood in log.Moods)
                                {
                                    <span class="symptom-badge bg-theme-clr-main text-black">@mood</span>
                                }
                            </div>
                        }

                        @if (log.HadBleeding)
                        {
                            <div class="mb-2">
                                <span class="badge bg-danger">Bleeding: @log.BleedingType</span>
                                @if (!string.IsNullOrEmpty(log.BleedingColor))
                                {
                                    <span class="badge bg-warning text-dark">Color: @log.BleedingColor</span>
                                }
                            </div>
                        }

                        <!-- Urinary Symptoms -->
                        <div class="mb-2">
                            @if (log.CoughWeeYesNo == true)
                            {
                                <span class="badge bg-info">Cough Leak</span>
                            }
                            @if (log.SneezeWeeYesNo == true)
                            {
                                <span class="badge bg-info">Sneeze Leak</span>
                            }
                            @if (log.LaughWeeYesNo == true)
                            {
                                <span class="badge bg-info">Laugh Leak</span>
                            }
                            @if (log.BladderPainYesNo == true)
                            {
                                <span class="badge bg-warning">Bladder Pain</span>
                            }
                            @if (log.UTIOften == true)
                            {
                                <span class="badge bg-danger">Frequent UTI</span>
                            }
                        </div>

                        <!-- Other Symptoms -->
                        <div class="mb-2">
                            @if (log.HairLossYesNo == true)
                            {
                                <span class="badge bg-secondary">Hair Loss</span>
                            }
                            @if (log.WeightGainYesNo == true)
                            {
                                <span class="badge bg-secondary">Weight Gain</span>
                            }
                            @if (log.BlemishShowing == true)
                            {
                                <span class="badge bg-secondary">Skin Blemishes</span>
                            }
                        </div>
                    </div>

                    <div id="log-details-menopause-@log.EntryId" class="d-none mt-3">

                        <!-- Symptoms & Severity -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-section">
                                    <h6>Core Symptoms</h6>
                                    <p><strong>Hot Flashes:</strong> @log.HotFlashesSeverity</p>
                                    <p><strong>Night Sweats:</strong> @log.NightSweatsSeverity</p>
                                    <p><strong>Energy Level:</strong> @log.EnergyLevel</p>
                                    <p><strong>Libido:</strong> @log.Libido</p>
                                    <p><strong>Sleep Quality:</strong> @log.SleepQuality</p>
                                </div>

                                <!-- Urinary Health -->
                                <div class="detail-section">
                                    <h6>Urinary & Bladder Health</h6>
                                    <p><strong>Urination Rating:</strong> @log.UrinationRating/10</p>
                                    @if (log.CoughWeeYesNo.HasValue)
                                    {
                                        <p><strong>Cough Leakage:</strong> @(log.CoughWeeYesNo.Value ? "Yes" : "No")</p>
                                        @if (!string.IsNullOrEmpty(log.CoughWeeNotes))
                                        {
                                            <p><small>@log.CoughWeeNotes</small></p>
                                        }
                                    }
                                    @if (log.SneezeWeeYesNo.HasValue)
                                    {
                                        <p><strong>Sneeze Leakage:</strong> @(log.SneezeWeeYesNo.Value ? "Yes" : "No")</p>
                                        @if (!string.IsNullOrEmpty(log.SneezeWeeNotes))
                                        {
                                            <p><small>@log.SneezeWeeNotes</small></p>
                                        }
                                    }
                                    @if (log.LaughWeeYesNo.HasValue)
                                    {
                                        <p><strong>Laugh Leakage:</strong> @(log.LaughWeeYesNo.Value ? "Yes" : "No")</p>
                                        @if (!string.IsNullOrEmpty(log.LaughWeeNotes))
                                        {
                                            <p><small>@log.LaughWeeNotes</small></p>
                                        }
                                    }
                                    @if (log.BladderPainYesNo.HasValue)
                                    {
                                        <p><strong>Bladder Pain:</strong> @(log.BladderPainYesNo.Value ? "Yes" : "No")</p>
                                        @if (!string.IsNullOrEmpty(log.BladderPainNotes))
                                        {
                                            <p><small>@log.BladderPainNotes</small></p>
                                        }
                                    }
                                    @if (log.UTIOften == true)
                                    {
                                        <p><strong>UTI Concern:</strong> Frequent urinary tract infections noted</p>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-section">
                                    <h6>Physical Changes</h6>
                                    <p><strong>Skin Dryness:</strong> @log.SkinDrynessRating/10</p>
                                    <p><strong>Breast Tenderness:</strong> @log.BreastTendernessRating/10</p>
                                    @if (log.HairLossYesNo.HasValue)
                                    {
                                        <p><strong>Hair Loss:</strong> @(log.HairLossYesNo.Value ? "Yes" : "No")</p>
                                        @if (!string.IsNullOrEmpty(log.HairLossNotes))
                                        {
                                            <p><small>@log.HairLossNotes</small></p>
                                        }
                                    }
                                    @if (log.WeightGainYesNo.HasValue)
                                    {
                                        <p><strong>Weight Gain:</strong> @(log.WeightGainYesNo.Value ? "Yes" : "No")</p>
                                        @if (!string.IsNullOrEmpty(log.WeightGainNotes))
                                        {
                                            <p><small>@log.WeightGainNotes</small></p>
                                        }
                                    }
                                    @if (log.WeightFluctuate.HasValue)
                                    {
                                        <p><strong>Weight Fluctuation:</strong> @(log.WeightFluctuate.Value ? "Yes" : "No")</p>
                                    }
                                    @if (log.BlemishShowing == true)
                                    {
                                        <p><strong>Skin Blemishes:</strong> Present</p>
                                    }
                                </div>

                                <!-- Bleeding & Medical -->
                                <div class="detail-section">
                                    <h6>Bleeding & Medical</h6>
                                    <p><strong>Bleeding:</strong> @(log.HadBleeding ? "Yes" : "No")</p>
                                    @if (log.HadBleeding)
                                    {
                                        <p><strong>Type:</strong> @log.BleedingType</p>
                                        @if (!string.IsNullOrEmpty(log.BleedingColor))
                                        {
                                            <p><strong>Color:</strong> @log.BleedingColor</p>
                                        }
                                    }
                                    @if (log.HadAbnormalBleeding)
                                    {
                                        <p><strong>Abnormal Bleeding:</strong> Yes</p>
                                        <p><strong>Pattern:</strong> @log.BleedingPattern</p>
                                    }
                                    @if (log.HadPelvicPain)
                                    {
                                        <p><strong>Pelvic Pain:</strong> Yes</p>
                                        <p><strong>Severity:</strong> @log.PainSeverity</p>
                                    }
                                    @if (log.IsOnHormoneTherapy)
                                    {
                                        <p><strong>Hormone Therapy:</strong> Yes</p>
                                        @if (!string.IsNullOrEmpty(log.HormoneTherapyNotes))
                                        {
                                            <p><strong>Therapy Notes:</strong> @log.HormoneTherapyNotes</p>
                                        }
                                    }
                                    @if (log.BloodPressureDaily == true)
                                    {
                                        <p><strong>Blood Pressure:</strong> @log.BloodPressureReadings</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Lifestyle & Additional Information -->
                        <div class="row mt-2">
                            @if (log.LifestyleFactors.Any())
                            {
                                <div class="col-md-6">
                                    <div class="detail-section">
                                        <h6>Lifestyle Factors</h6>
                                        @foreach (var factor in log.LifestyleFactors)
                                        {
                                            <span class="badge bg-primary mb-2">@factor</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(log.Notes))
                            {
                                <div class="col-md-6">
                                    <div class="detail-section">
                                        <h6>Daily Notes</h6>
                                        <div class="reflection-box">
                                            <i class="bi bi-chat-quote text-muted me-2"></i>
                                            @log.Notes
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Doctor's Notes Section -->
                        <div class="doctors-notes-section mt-3 border-top pt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">
                                    <i class="bi bi-clipboard-plus text-primary"></i> Doctor's Notes
                                </h6>
                                <button class="btn btn-sm btn-outline-secondary @(trackerType)-edit-notes-btn"
                                        data-log-id="@log.EntryId"
                                        data-original-notes="@log.DoctorsNotes">
                                    <i class="bi bi-pencil"></i> Add Notes
                                </button>
                            </div>

                            <!-- Display current notes -->
                            <div id="@(trackerType)-doctors-notes-display-@log.EntryId" class="@(trackerType)-doctors-notes-display">
                                @if (!string.IsNullOrEmpty(log.DoctorsNotes))
                                {
                                    <div class="notes-content bg-light p-3 rounded">
                                        <p class="mb-0 text-theme-clr-main-dark">@log.DoctorsNotes</p>
                                        <small class="text-muted fs-10">
                                            @if (log.DoctorResponseTime.HasValue)
                                            {
                                                <text>Last updated: @log.DoctorResponseTime.Value.ToString("dd MMM yyyy HH:mm")</text>
                                            }
                                            else
                                            {
                                                <text>No update time recorded</text>
                                            }
                                        </small>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted fst-italic">
                                        <i class="bi bi-info-circle"></i> No notes yet
                                    </div>
                                }
                            </div>

                            @{
                                var editorId = $"notes-textarea-{trackerType}-{log.EntryId}";
                            }
                            <!-- Edit notes section (hidden by default) -->
                            <div id="@(trackerType)-doctors-notes-edit-@log.EntryId" class="@(trackerType)-doctors-notes-edit d-none">
                                <textarea class="form-control notes-textarea"
                                  id="@editorId"
                                  rows="3"
                                  placeholder="Enter doctor's notes here...">@log.DoctorsNotes</textarea>
                                <div class="mt-2 d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-outline-secondary @(trackerType)-cancel-edit-btn"
                                            data-log-id="@log.EntryId">
                                        Cancel
                                    </button>
                                    <button class="btn btn-sm btn-primary @(trackerType)-save-notes-btn"
                                            onclick="SaveDoctorNotesMenopause('@log.MenopauseTrackerLogId', '@log.EntryId','@editorId')">
                                        <i class="bi bi-check-lg"></i> Save Notes
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Pagination Controls -->
            <div class="pagination-controls mt-4 d-flex justify-content-between align-items-center" id="@(trackerType)-pagination-controls">
                <div class="pagination-info">
                    <small class="text-muted">Page <span class="current-page">1</span> of <span class="total-pages">0</span></small>
                </div>
                <div class="pagination-buttons">
                    <button class="btn btn-outline-primary btn-sm me-2 @(trackerType)-newer-btn" style="display: none;">
                        <i class="bi bi-chevron-left"></i> Newer
                    </button>
                    <button class="btn btn-outline-primary btn-sm @(trackerType)-older-btn" style="display: none;">
                        Older <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<script>

    function navigateToPage@(trackerType.ToUpper())(page) {
        const pageSize = 3;
        const startIndex = (page - 1) * pageSize;
        const endIndex = startIndex + pageSize;

        // Hide all menopause logs, show only current page
        $('.@(trackerType)-log-entry').hide().slice(startIndex, endIndex).show();

        updatePaginationControls@(trackerType.ToUpper())(page);
        closeAllDetails@(trackerType.ToUpper())();
    }

    function updatePaginationControls@(trackerType.ToUpper())(currentPage) {
        const totalLogs = $('.@(trackerType)-log-entry').length;
        const pageSize = 3;
        const totalPages = Math.ceil(totalLogs / pageSize);

        // Update displayed text
        const start = ((currentPage - 1) * pageSize) + 1;
        const end = Math.min(currentPage * pageSize, totalLogs);
        $('#@(trackerType)-pagination-info small').text(`Showing ${start}-${end} of ${totalLogs} logs`);
        $('#@(trackerType)-pagination-controls .current-page').text(currentPage);
        $('#@(trackerType)-pagination-controls .total-pages').text(totalPages);

        // Update buttons
        $('.@(trackerType)-newer-btn').toggle(currentPage > 1);
        $('.@(trackerType)-older-btn').toggle(currentPage < totalPages);
    }

    function closeAllDetails@(trackerType.ToUpper())() {
        $('[id^="log-details-menopause-"]').addClass('d-none');
        $('.@(trackerType)-toggle-details-btn i').removeClass('bi-chevron-up').addClass('bi-chevron-down');
    }

    // Event handlers with jQuery - scoped to menopause tracker
    $(document).ready(function() {
        // Menopause pagination button clicks
        $('#@(trackerType)-card-body').on('click', '.@(trackerType)-newer-btn', function() {
            const currentPage = parseInt($('#@(trackerType)-pagination-controls .current-page').text());
            navigateToPage@(trackerType.ToUpper())(currentPage - 1);
        });

        $('#@(trackerType)-card-body').on('click', '.@(trackerType)-older-btn', function() {
            const currentPage = parseInt($('#@(trackerType)-pagination-controls .current-page').text());
            navigateToPage@(trackerType.ToUpper())(currentPage + 1);
        });

        // Menopause toggle details
        $('#@(trackerType)-card-body').on('click', '.@(trackerType)-toggle-details-btn', function() {
            const $btn = $(this);
            const logId = $btn.data('log-id');
            const $details = $('#log-details-menopause-' + logId);
            const $icon = $btn.find('i');

            $details.toggleClass('d-none');
            $icon.toggleClass('bi-chevron-down bi-chevron-up');
        });

        // Initialize menopause tracker
        navigateToPage@(trackerType.ToUpper())(1);
        initializeDoctorsNotes@(trackerType.ToUpper())();
    });

    // Doctors Notes functionality
    function initializeDoctorsNotes@(trackerType.ToUpper())() 
    {
        $('#@(trackerType)-card-body').on('click', '.@(trackerType)-edit-notes-btn', function() {
            const logId = $(this).data('log-id');
            const originalNotes = $(this).data('original-notes') || '';

            // Show edit section, hide display section
            $('#@(trackerType)-doctors-notes-display-' + logId).hide();
            $('#@(trackerType)-doctors-notes-edit-' + logId).removeClass('d-none');

            // Focus the textarea
            $('#notes-textarea-' + logId).focus();
        });

        // Cancel edit button click
        $('.card-body').on('click', '.@(trackerType)-cancel-edit-btn', function() {
            const logId = $(this).data('log-id');
            const originalNotes = $('.@(trackerType)-edit-notes-btn[data-log-id="' + logId + '"]').data('original-notes') || '';

            // Reset textarea to original value
            $('#notes-textarea-' + logId).val(originalNotes);

            // Show display section, hide edit section
            $('#@(trackerType)-doctors-notes-edit-' + logId).addClass('d-none');
            $('#@(trackerType)-doctors-notes-display-' + logId).show();

            // Hide save button
            $('.@(trackerType)-save-notes-btn[data-log-id="' + logId + '"]').addClass('d-none');
        });

        // Textarea input change
        $('.card-body').on('input', '.notes-textarea', function() {
            const logId = $(this).attr('id').replace('notes-textarea-', '');
            const currentValue = $(this).val();
            const originalNotes = $('.@(trackerType)-edit-notes-btn[data-log-id="' + logId + '"]').data('original-notes') || '';

            // Show/hide save button based on changes
            const saveBtn = $('.@(trackerType)-save-notes-btn[data-log-id="' + logId + '"]');
            if (currentValue !== originalNotes) {
                saveBtn.removeClass('d-none');
            } else {
                saveBtn.addClass('d-none');
            }
        });
    }

    function updateDoctorsNotesUI(logId, notes) {
        // Update the display section
        const displaySection = $('#@(trackerType)-doctors-notes-display-' + logId);

        if (notes) {
            displaySection.html(`
                <div class="notes-content bg-light p-3 rounded">
                    <p class="mb-0">${notes}</p>
                    <small class="text-muted">Last updated: Just now</small>
                </div>
            `);
        } else {
            displaySection.html(`
                <div class="text-muted fst-italic">
                    <i class="bi bi-info-circle"></i> No notes yet
                </div>
            `);
        }

        // Update the edit button data
        $('.@(trackerType)-edit-notes-btn[data-log-id="' + logId + '"]').data('original-notes', notes);

        // Hide edit section, show display section
        $('#@(trackerType)-doctors-notes-edit-' + logId).addClass('d-none');
        displaySection.show();

        // Hide save button
        $('.@(trackerType)-save-notes-btn[data-log-id="' + logId + '"]').addClass('d-none');
    }

    function showToast(message, type = 'info') {
        // Simple toast notification
        const toast = $(`
            <div class="toast align-items-center text-bg-${type === 'success' ? 'success' : 'danger'} border-0 position-fixed top-0 end-0 m-3" role="alert">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        `);

        $('body').append(toast);
        const bsToast = new bootstrap.Toast(toast[0]);
        bsToast.show();

        // Remove toast after hide
        toast.on('hidden.bs.toast', function() {
            $(this).remove();
        });
    }



    function SaveDoctorNotesMenopause(moduleLogId, entryId, notesEditorId)
    {
        ShowAlertModal(
             'Add Notes for this day?',
             `Are you sure you want to Submit notes to patient? The patient will be notified about this immediately.`,
             '@AlertModalIconType.Question').then(function (confirmed)
        {
            var url = "@Url.Action("UpdateModuleLogDoctorsNotes", "Doctor")";

            var payload =
            {
                ModuleType: '@ModuleType.MenopauseTracker',
                PatientUserId: '@Model.PatientUserId',
                ModuleLogId: moduleLogId,
                EntryId: entryId,
                Notes: $(`#${notesEditorId}`).val()
            };

            ShowAppLoader("Sending notes to patient...");

            PerformAction(url, "POST", payload, MenopauseNotesCallback);
        });
    }

    function MenopauseNotesCallback(success, response)
    {
        if (success)
        {
            HideAppLoader();

            ShowAlertModal(
                'Notes saved',
                `Your notes for the day have been saved and sent to user`,
                '@AlertModalIconType.Information').then(function (confirmed)
            {
                ForceHardReloadNow();
            });
        }
        else
        {
            HideAppLoader();
            ShowAlertModal('Not Saved', `Something went wrong, please try again later`, '@AlertModalIconType.Error');
        }
    }

</script>