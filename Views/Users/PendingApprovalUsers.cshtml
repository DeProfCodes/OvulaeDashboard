@using OvulaeDashboard.ViewModels.Admin

@model List<UserAdminDetailsViewModel>

@{
    var planNames = new List<string>();//Model.Select(x => x.PlanName).Distinct().ToList();
    var index = 1;
}

@{
    await Html.RenderPartialAsync("~/Views/Components/Breadcrumb.cshtml", new BreadcrumbViewModel
            {
                Icon = "bi-people-fill",
                PageType = AppPageType.PendingApprovalUsers
            });
}

<div class="row">
    <div class="card">
        <div class="card-header">
            <h5 class="text-primary">Pending Approval Users</h5>
        </div>

        <div class="p-0 card-body">
            <div class="app-scroll table-responsive app-datatable-default">
                <div id="DefaultDataTable_wrapper" class="dataTables_wrapper no-footer">                   
                    <table id="PendingUsers" class="w-100 display default-data-table align-middle table">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th class="text-center">Fullname</th>
                                <th class="text-center">Phone Number</th>
                                <th class="text-center">Country</th>
                                <th class="text-center">Join Date</th>
                                <th class="text-center">Account Status</th>
                                <th class="text-center">Subscription Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody class="fs-12">
                            @foreach (var user in Model)
                            {
                                var rowCss = (index++ % 2) == 0 ? "even" : "odd";
                                var accountBadge = HtmlCssHelper.GetBadgeCssForAccountStatus(user.AccountStatus);
                                
                                <tr class="@rowCss">
                                    <td class="table-td">@user.Email</td>
                                    <td class="table-td text-center">@user.FullName</td>
                                    <td class="table-td text-center">@user.PhoneNumber</td>
                                    <td class="table-td text-center text-primary">@Html.Raw(HtmlCssHelper.GetCountryAndFlagDiv(user.CountryCode))</td>
                                    <td class="table-td text-center">@user.JoinDate</td>
                                    <td class="table-td text-center"><span class="badge text-light-@accountBadge">@user.AccountStatus.GetDisplayDescription()</span></td>
                                    <td class="table-td text-center">@user.SubscriptionJoinDate</td>
                                    <td>
                                        <button class="btn btn-sm btn-success mb-1" onclick="ApproveNewPortalUser('@user.FullName', '@user.Email', '@user.UserRole')">Approve</button>
                                        <button class="btn btn-sm btn-danger mb-1" onclick="RejectNewPortalUser('@user.FullName', '@user.Email')">Reject</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Components/Dashboard/ApproveUserModal.cshtml");
}

<script>

    var planNameFilter = "";

    $(document).ready(function ()
    {
        HideAppLoader();
        PlanNameFilterText();
        MobileScreenUpdates();

        if ($('#PendingUsers').length)
        {
            // Custom filter logic
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex)
            {
                if (!planNameFilter) return true;

                const planNameColumnIndex = 0;
                const planName = data[planNameColumnIndex] || "";
                return planName.toLowerCase().includes(planNameFilter.toLowerCase());
            });

            PendingUsersDT = $('#PendingUsers').DataTable(
            {
                pagingType: 'simple_numbers',
                lengthMenu: [10, 25, 50, 100],
                order: [],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    paginate: {
                        previous: "Previous",
                        next: "Next"
                    }
                }
            });
        }
    });

    function FilterAllResultsByPlanName()
    {
        var name= $("#FilterReturnsByName").val();

        planNameFilter = name;
        if (PendingUsersDT)
        {
            PendingUsersDT.draw();
        }
    }

    $(window).on("resize", function ()
    {
        PlanNameFilterText();
    });

    function PlanNameFilterText()
    {
        if ($(window).width() <= 768)
        {
            $("#FilterReturnsByNameTitle").text("Plan Name:");
        }
        else
        {
            $("#FilterReturnsByNameTitle").text("Filter By Plan Name:");
        }
    }

    function AddNewUserModal()
    {
        
    }

    var approvingUser = '';

    function ApproveNewPortalUser(fullname, email, role)
    {
        OpenApproveUserModal(fullname, role).then(function (okay)
        {
            if(okay)
            {
                var newRole = $('#UserModalRole').val();
                approvingUser = fullname;

                ShowAlertModal(
                     'Approve User',
                     `Are you sure you want to Approve <span class='fw-bold text-theme-clr-main'>${fullname}</span> to be a 
                      <span class='fs-16 fw-bold text-theme-clr-2'>${newRole}</span>`,
                     '@AlertModalIconType.Question').then(function (confirmed)
                {
                     if(confirmed)
                     {
                        ShowAppLoader(`Onboarding User as ${newRole}...`);

                        var url = "@Url.Action("ApproveUser", "Admin")";

                        var payload = 
                        { 
                            email: email, 
                            UserRole: newRole == "Doctor" ? "@UserRoleType.Doctor" : "@UserRoleType.Affiliate",
                            ApproveUser: true
                        };

                        PerformAction(url, "POST", payload, ApproveNewPortalUserCallback);
                    }
                });
            }
        });
    }

    function ApproveNewPortalUserCallback(success, response)
    {
        HideAppLoader();
        if (success)
        {
            ShowAlertModal("User Approved 🥳", `You have successfull Approved ${approvingUser} as ${$('#UserModalRole').val()}`, "@AlertModalIconType.Success").then(function(okay)
            {
                NavigateToPage('@AppPageType.PendingApprovalUsers');
            });
        }
        else
        {
            ShowAlertModal("Error ❌", "Failed to process approve user, something went wrong, Please try again. If the error persist then contact support.", "@AlertModalIconType.Error");
        }
    }

    function RejectNewPortalUser(fullname, email)
    {
        ShowAlertModal(
             'Reject User',
             `Are you sure you want to Reject <span class='fw-bold text-theme-clr-main'>${fullname}</span> from Ovulae Portal`,
             '@AlertModalIconType.Question').then(function (confirmed)
        {
             if(confirmed)
             {
                approvingUser = fullname;
                ShowAppLoader(`Rejecting User...`);

                var url = "@Url.Action("RejectUser", "Admin")";

                var payload =
                {
                    email: email,
                    UserRole: "@UserRoleType.None",
                    ApproveUser: false
                };

                PerformAction(url, "POST", payload, RejectNewPortalUserCallback);
            }
        });
    }

    function RejectNewPortalUserCallback(success, response)
    {
        HideAppLoader();
        if (success)
        {
            ShowAlertModal("User Rejected ☑️", `You have successfull Rejected ${approvingUser}`, "@AlertModalIconType.Success").then(function(okay)
            {
                NavigateToPage('@AppPageType.PendingApprovalUsers');
            });
        }
        else
        {
            ShowAlertModal("Error", "Failed to process reject user, something went wrong, Please try again. If the error persist then contact support.", "@AlertModalIconType.Error");
        }
    }

</script>